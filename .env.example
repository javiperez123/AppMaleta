# Copia este archivo como .env.local y rellena lo que necesites. Nunca subas .env* al repositorio.

# Carpeta donde se guardan usuarios, viajes y fotos (por defecto ./data). En producción, un volumen persistente con copia de seguridad.
# DATA_DIR=/var/lib/maleta

# URL pública de la app, usada en los enlaces de recuperación de contraseña (si no, se deduce de la petición).
# APP_URL=https://tu-dominio.com

# Envío de correos (recuperación de contraseña) con Resend. Sin esto, en desarrollo el enlace se muestra en la consola
# del servidor y en producción la app avisa de que el envío no está disponible.
# RESEND_API_KEY=
# MAIL_FROM="Maleta <hola@tu-dominio.com>"

# Pon "off" para desactivar las consultas a Open-Meteo (geocodificación y tiempo).
# WEATHER_PROVIDER=off

# Solo para pruebas locales de producción sobre http (no https): permite la cookie de sesión sin "Secure".
# INSECURE_COOKIES=1
