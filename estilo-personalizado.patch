+// ======================= Perfil de estilo =======================
+
+export async function saveStyleProfile(userId: string, swipes: { id: string; liked: boolean }[]): Promise<void> {
+  const { CATALOG } = await import("@/lib/domain/catalog");
+  await updateUserData(userId, (d) => {
+    const catalogMap = new Map(CATALOG.map(c => [c.id, c]));
+    const liked = swipes.filter(s => s.liked).map(s => catalogMap.get(s.id)).filter(Boolean);
+    if (liked.length === 0) {
+      d.styleProfile = { formality: 0.5, boldness: 0.5, streetwear: 0.5, swipeCount: swipes.length, likedIds: [], updatedAt: nowIso() };
+      return;
+    }
+    // Promediar dimensiones de las prendas que gustaron
+    const formality = liked.reduce((sum, c) => sum + (c!.formality / 3), 0) / liked.length;
+    const boldness = liked.reduce((sum, c) => sum + c!.boldness, 0) / liked.length;
+    const streetwear = liked.reduce((sum, c) => sum + c!.streetwear, 0) / liked.length;
+    d.styleProfile = {
+      formality: Math.max(0, Math.min(1, formality)),
+      boldness: Math.max(0, Math.min(1, boldness)),
+      streetwear: Math.max(0, Math.min(1, streetwear)),
+      swipeCount: swipes.length,
+      likedIds: swipes.filter(s => s.liked).map(s => s.id),
+      updatedAt: nowIso(),
+    };
+  });
+}
