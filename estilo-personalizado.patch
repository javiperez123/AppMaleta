+    const { fetchWeatherRange: fwr } = await import("@/lib/domain/weather");
+    const ranges = await fwr(lat, lon, today, today, today);
+    weather = ranges.get(today);
+  }
+  const fakeDay = {
+    date: today,
+    city: settings.homeCity,
+    activities: [],
+    discardedKeys: [],
+    weather,
+  };
+  const { generateLook: gl } = await import("@/lib/domain/engine");
+  const look = gl(garments, fakeDay, {
+    usedCounts: new Map(),
+    previousIds: new Set(),
+    baggage: "cabina",
+    laundry: false,
+    excludeKeys: new Set(),
+    newId,
+    now: nowIso(),
+  });
+  await updateUserData(userId, (d) => {
+    d.daily = { date: today, city: settings!.homeCity!, weather, look };
+  });
+}
